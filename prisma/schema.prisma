// SwiftVerify database schema.
// Phase 1: this file is the data contract (landing page runs on lib/content.ts).
// Phase 2: run `npm i -D prisma && npm i @prisma/client`, set DATABASE_URL,
//          then `npx prisma migrate dev` and `npx prisma db seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app runtime (Neon/Supabase pooler).
  url       = env("DATABASE_URL")
  // Direct connection for migrations. Set to the same URL if you only have one.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  USDT_TRC20
  BINANCE_PAY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String? // null for guest-checkout clients until they set one (Phase 3 auth)
  role      Role     @default(CLIENT)
  name      String?
  country   String?
  phone     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String
  priceKES        Int
  isPromoEligible Boolean  @default(true)
  orders          Order[]
  createdAt       DateTime @default(now())
}

model Order {
  id            String        @id @default(cuid())
  clientId      String
  client        User          @relation(fields: [clientId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  status        OrderStatus   @default(PENDING_PAYMENT)
  priceKES      Int
  paymentMethod PaymentMethod @default(MPESA)
  mpesaProofUrl String? // payment proof screenshot (M-PESA receipt or crypto tx screenshot)
  mpesaPhone    String? // payment reference: M-PESA sender phone, or wallet/txn id for crypto
  notes         String?
  promo         PromoTracker?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  approvedAt    DateTime?

  @@index([status])
  @@index([clientId])
}

model PromoTracker {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  usedPromoCode Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  email      String?
  country    String
  service    String
  rating     Int
  review     String
  photoUrl   String?
  isActive   Boolean  @default(true)
  source     String // "TELEGRAM" | "DIRECT"
  createdAt  DateTime @default(now())
  comments   ReviewComment[]
}

model ReviewComment {
  id        String         @id @default(cuid())
  reviewId  String
  review    Testimonial    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ReviewComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ReviewComment[] @relation("CommentReplies")
  authorName String
  email      String?
  body      String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@index([reviewId, createdAt])
  @@index([parentId])
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // "promo_count", "current_tip", "mpesa_phone", ...
  value     String // JSON
  updatedAt DateTime @updatedAt
}

enum StripeOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Standalone checkout order for the USD service lineup (Payoneer/Stripe
// onboarding etc.), paid via Stripe Checkout. Deliberately decoupled from the
// legacy KES `Order`/`Service`/`User` models above — those keep serving the
// existing M-PESA/USDT/Binance manual-proof flow and historical orders
// untouched. `amountUSD` is stored in cents to avoid float rounding.
model StripeOrder {
  id                    String            @id @default(cuid())
  serviceSlug           String
  serviceName           String
  amountUSD             Int
  currency              String            @default("usd")
  fullName              String
  businessName          String?
  email                 String
  phone                 String
  country               String
  website               String?
  notes                 String?
  stripeSessionId       String            @unique
  stripePaymentIntentId String?           @unique
  status                StripeOrderStatus @default(PENDING)
  receiptUrl            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  paidAt                DateTime?

  @@index([status])
  @@index([email])
}
