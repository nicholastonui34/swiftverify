# ---- Database (Phase 2) ----
# Vercel Postgres or Railway. Prisma reads DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/swiftverify"

# ---- Auth.js v5 (Phase 3) ----
# Generate: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
# Auto-detected on Vercel; only needed for non-Vercel hosting.
# AUTH_URL="http://localhost:3100"

# One-time admin bootstrap — read by `npm run admin:create` (scripts/create-admin.ts).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="a-strong-password"
ADMIN_NAME="Admin"

# ---- Email / Gmail SMTP (Phase 4) ----
# Gmail account + App Password (not the normal password): https://myaccount.google.com/apppasswords
# When unset, emails degrade to console logs (flow never breaks).
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD=""
# Note: the admin *recipient* address is set in the admin dashboard → Settings,
# not here. ADMIN_EMAIL above is only used by the admin:create bootstrap script.

# ---- Telegram admin notifications (Phase 4) ----
# Create a bot with @BotFather → token. Get your chat id from @userinfobot.
# Chat id can also be set in admin Settings. Unset = notifications skipped.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ---- Rate limiting (Phase 7) ----
# Optional Upstash Redis (REST) for distributed rate limiting. When unset, a
# per-instance in-memory limiter is used (fine for dev/single instance).
# Create a free DB at https://console.upstash.com → REST URL + token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Public site ----
# Used for links inside emails (payment link, admin link) and canonical/OG URLs.
NEXT_PUBLIC_SITE_URL="https://swiftverify-alpha.vercel.app"

# ---- M-PESA merchant (default; configurable in admin Settings) ----
MPESA_MERCHANT_PHONE="0722000000"
